{
  "name": "pi-implementation-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Pi extension that separates planning, implementation, and review, with a shared on-disk plan and a browser dashboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rowantran/pi-implementation-workflow.git"
  },
  "homepage": "https://github.com/rowantran/pi-implementation-workflow#readme",
  "bugs": {
    "url": "https://github.com/rowantran/pi-implementation-workflow/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "workflow",
    "planning",
    "pull-request",
    "code-review"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test test/*.test.ts",
    "test": "npm run typecheck && npm run test:unit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/mustache": "^4.2.6",
    "@types/node": "24.12.4",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "marked": "^18.0.5",
    "mustache": "^4.2.0",
    "smol-toml": "^1.8.0",
    "mermaid": "^11.12.3"
  }
}
