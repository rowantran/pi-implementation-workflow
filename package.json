{
  "name": "pi-implementation-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Pi extension that separates implementation planning, implementation, and pull request review.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rowantran/pi-implementation-workflow.git"
  },
  "homepage": "https://github.com/rowantran/pi-implementation-workflow#readme",
  "bugs": {
    "url": "https://github.com/rowantran/pi-implementation-workflow/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "workflow",
    "planning",
    "pull-request",
    "code-review"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "scripts": {
    "smoke": "node ./scripts/smoke.mjs",
    "test:dashboard": "node ./scripts/dashboard-test.mjs",
    "test:planning": "node ./scripts/planning-test.mjs",
    "test:prompts": "node ./scripts/prompts-test.mjs",
    "test:storage": "node ./scripts/storage.mjs",
    "test:ui": "node ./scripts/ui-test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run smoke && npm run test:dashboard && npm run test:planning && npm run test:prompts && npm run test:storage && npm run test:ui"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/mustache": "^4.2.6",
    "@types/node": "24.12.4",
    "jiti": "2.7.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "mustache": "^4.2.0"
  }
}
